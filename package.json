{
  "name": "research-bot",
  "version": "0.3.4",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Srimi1/research------bot.git"
  },
  "description": "A human-led research workspace",
  "main": "dist-electron/main.cjs",
  "desktopName": "research-bot.desktop",
  "author": "Srimi1",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "icon": "node scripts/render-icon.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/ui-smoke.mjs && node scripts/review-smoke.mjs && node scripts/mobile-smoke.mjs && node scripts/signin-smoke.mjs && node scripts/android-webview-smoke.mjs",
    "test:electron": "node scripts/electron-smoke.mjs",
    "test:electron-node": "node scripts/electron-node-tests.mjs",
    "test:toolchain": "node scripts/toolchain-smoke.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "build:android": "tsc --noEmit && vite build && cap sync android",
    "android:apk": "npm run build:android && cd android && ./gradlew assembleRelease",
    "icon:android": "node scripts/render-android-icons.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.56.0",
    "prettier": "3.9.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.14.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "undici": "^7.16.0",
    "vite": "^7.1.0",
    "wait-on": "^9.0.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "concurrently": {
      "shell-quote": "1.12.0"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "@electron/get@3.1.0": {
      "global-agent": "4.1.3"
    }
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "Srimi1",
        "repo": "research------bot"
      }
    ],
    "appId": "com.researchbot.desktop",
    "productName": "Research Bot",
    "artifactName": "research-bot-${version}-${os}-${arch}.${ext}",
    "icon": "public/app-icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "agents/**",
      "LICENSE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "syncDesktopName": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "artifactName": "research-bot-${version}-win-${arch}-setup.${ext}"
    }
  }
}
